{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PMCO",
  "mainBinaryName": "PMCO",
  "version": "0.3.0",
  "identifier": "com.cdc.collection",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PMCO",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob: asset: http://asset.localhost https:",
        "media-src": "'self' data: blob: asset: http://asset.localhost https://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://ogpzmnaqybxybybooebi.supabase.co https://api.discogs.com https://musicbrainz.org https://coverartarchive.org https://archive.org https://*.archive.org https://api.github.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/audio/**", "$APPDATA/covers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Music",
    "resources": { "resources/flac/": "flac/" },
    "shortDescription": "Catalogue your physical music collection",
    "longDescription": "PMCO catalogues physical music across CD, vinyl, cassette and other media, with mixed-media sets, works, performers, favorites and local audio.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "A095093C-258B-5ED8-8E7E-48EA16A86CE9"
      },
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "Japanese"],
        "displayLanguageSelector": true
      }
    }
  }
}
